# VibeCode API
# Получить ключ: https://vibecode.bitrix24.tech → Ключи API → Создать
VIBE_API_KEY=vibe_api_YOUR_KEY_HERE
VIBE_BASE_URL=https://vibecode.bitrix24.tech/v1

# Сервер Vibecode (заполняется после первого деплоя)
# Создать сервер: POST /v1/infra/servers (или через npm run deploy — он создаст автоматически)
SERVER_ID=

# Приложение
PORT=3000
NODE_ENV=production

# Хранилище данных
# Локально: ./data (создаётся автоматически)
# Прод (Vibecode): /opt/data (переживает деплой, задаётся в deploy.sh)
DATA_DIR=/opt/data

# Trusted Bitrix24 portal for user authentication (hostname only)
B24_DOMAIN=crmby.bitrix24.by
